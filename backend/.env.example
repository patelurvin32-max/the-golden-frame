# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Database (Supports MongoDB Atlas Cluster or Local MongoDB)
# Example MongoDB Atlas Cluster: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cuemaster?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/thegoldenframe

# JWT
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=30d

# Cookies
COOKIE_SECRET=replace_with_cookie_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Golden Frame <no-reply@thegoldenframe.app>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Super Admin (for initial setup)
SUPER_ADMIN_EMAIL=admin@thegoldenframe.app
SUPER_ADMIN_PASSWORD=Admin@123456

# Seeding (set to 'true' to force seeding in production)
ENABLE_DEFAULT_SEED=false

# CSRF (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CSRF_SECRET=replace_with_random_64_char_hex_string
